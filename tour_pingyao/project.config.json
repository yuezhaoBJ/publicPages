{
  "description": "若误打开仓库根目录，会自动使用 native/ 作为小程序根",
  "miniprogramRoot": "native/",
  "compileType": "miniprogram",
  "libVersion": "2.33.0",
  "appid": "touristappid",
  "projectname": "shanxi-agent-native",
  "setting": {
    "urlCheck": false,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": false,
    "compileHotReLoad": false,
    "useMultiFrameRuntime": false
  },
  "packOptions": {
    "ignore": [
      {
        "type": "folder",
        "value": "assets"
      },
      {
        "type": "folder",
        "value": "tools"
      },
      {
        "type": "folder",
        "value": ".devtools-install"
      },
      {
        "type": "folder",
        "value": ".git"
      },
      {
        "type": "folder",
        "value": "native/_src"
      },
      {
        "type": "file",
        "value": "index.html"
      },
      {
        "type": "file",
        "value": "native.zip"
      }
    ]
  }
}
